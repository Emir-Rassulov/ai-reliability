{
  "schema_version": "1.0",
  "synthetic": true,
  "scenarios": [
    {
      "id": "nb-001",
      "name": "Return window is answered from the knowledge base",
      "category": "llm",
      "severity": "high",
      "tags": [
        "facts",
        "happy-path"
      ],
      "input": {
        "messages": [
          {
            "role": "user",
            "content": "How many days do I have to return a book?"
          }
        ]
      },
      "checks": [
        "required_facts",
        "refusal"
      ],
      "required_facts": [
        {
          "id": "window",
          "phrases": [
            "30 days",
            "thirty days"
          ],
          "number": 30,
          "mandatory": true
        }
      ]
    },
    {
      "id": "nb-002",
      "name": "Shipping time is answered from the knowledge base",
      "category": "llm",
      "severity": "high",
