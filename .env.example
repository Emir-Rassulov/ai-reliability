# Copy to .env (git-ignored). Variable names only; never commit values.
# Cost guard: "zero" (default) or "allow_paid".
AIREL_COST_MODE=
# Optional hard budget for paid runs, in USD. Requires a pricing file.
AIREL_MAX_COST_USD=
# Request timeout in seconds (default 30).
AIREL_REQUEST_TIMEOUT_S=
# Maximum retries for retryable provider errors (default 3).
AIREL_MAX_RETRIES=
